# Copie este arquivo para .env.prod e preencha os valores reais.
# NUNCA comite o .env.prod no git.

# ── Domínio ──────────────────────────────────────────────────────────────────
# Domínio principal sem "www" e sem "https://"
# Ex: ibbe.com.br  →  API em api.ibbe.com.br, app em ibbe.com.br
DOMINIO=seudominio.com.br

# ── Django ───────────────────────────────────────────────────────────────────
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=TROQUE-POR-CHAVE-ALEATORIA-LONGA

DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=api.seudominio.com.br
CORS_ALLOWED_ORIGINS=https://seudominio.com.br

# ── Banco de dados ────────────────────────────────────────────────────────────
DB_NAME=churchsmng
DB_USER=churchsmng
# Use uma senha forte! Ex: openssl rand -base64 24
DB_PASSWORD=SENHA-FORTE-AQUI
